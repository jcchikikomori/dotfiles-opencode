{
  "$schema": "https://opencode.ai/config.json",
  "update": "notify",
  "instructions": [
    "AGENTS.md"
  ],
  "plugins": [
    "oh-my-opencode-slim"
  ],
  "model": "{env:OPENCODE_MODEL}",
  "small_model": "{env:OPENCODE_SMALL_MODEL}",
  "lsp": true,
  "permissions": [
    { "action": "tool", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "git", "effect": "allow" },
    { "action": "bash", "resource": "git commit *", "effect": "deny" },
    { "action": "bash", "resource": "git commit", "effect": "deny" },
    { "action": "bash", "resource": "git push *", "effect": "deny" },
    { "action": "bash", "resource": "git push", "effect": "deny" },
    { "action": "bash", "resource": "git reset --hard *", "effect": "deny" },
    { "action": "bash", "resource": "git revert *", "effect": "ask" },
    { "action": "bash", "resource": "rm -rf *", "effect": "ask" },
    { "action": "bash", "resource": "sudo *", "effect": "ask" },
    { "action": "bash", "resource": "*", "effect": "allow" }
  ],
  "providers": {
    "github-copilot": {},
    "amazon-bedrock": {
      "settings": {
        "region": "{env:AWS_REGION}",
        "profile": "{env:AWS_PROFILE}"
      }
    }
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "buildkite-mcp": {
        "type": "remote",
        "url": "https://mcp.buildkite.com/mcp",
        "disabled": true
      },
      "github-mcp": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
        }
      },
      "web-forager": {
        "type": "local",
        "command": [
          "web-forager",
          "serve"
        ]
      },
      "camoufox": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "camoufox-mcp-server@latest"
        ]
      },
      "stackoverflow-mcp": {
        "type": "local",
        "command": [
          "stackoverflow-mcp"
        ],
        "environment": {
          "STACK_EXCHANGE_API_KEY": "{env:STACK_EXCHANGE_API_KEY}"
        },
        "disabled": true
      },
      "framelink-figma": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "figma-developer-mcp",
          "--stdio"
        ],
        "environment": {
          "FIGMA_API_KEY": "{env:FIGMA_API_KEY}"
        },
        "disabled": true
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--no-usage-statistics"
        ],
        "disabled": true
      },
      "atlassian-mcp": {
        "type": "local",
        "command": [
          "mcp-atlassian"
        ],
        "environment": {
          "JIRA_URL": "{env:JIRA_URL}",
          "JIRA_USERNAME": "{env:JIRA_USERNAME}",
          "JIRA_API_TOKEN": "{env:JIRA_API_TOKEN}",
          "CONFLUENCE_URL": "{env:CONFLUENCE_URL}",
          "CONFLUENCE_USERNAME": "{env:CONFLUENCE_USERNAME}",
          "CONFLUENCE_API_TOKEN": "{env:CONFLUENCE_API_TOKEN}"
        },
        "disabled": true
      },
      "sonarqube-mcp": {
        "type": "local",
        "command": [
          "docker",
          "run",
          "--pull=always",
          "-i",
          "--rm",
          "-e",
          "SONARQUBE_TOKEN",
          "-e",
          "SONARQUBE_URL",
          "mcp/sonarqube"
        ],
        "environment": {
          "SONARQUBE_TOKEN": "{env:SONARQUBE_TOKEN}",
          "SONARQUBE_URL": "{env:SONARQUBE_URL}"
        },
        "disabled": true
      },
      "rea": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "rea-agents@6.4.0",
          "mcp"
        ]
      }
    }
  },
  "agents": {
    "explore": {
      "disabled": true
    },
    "general": {
      "disabled": true
    }
  }
}
